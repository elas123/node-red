    {
        "id": "5bb09e7dc86461dd",
        "type": "function",
        "z": "56918b3e0e367f92",
        "name": "Calculate Evening Ramp (40%/2000K)",
        "func": "// Calculate closet-specific ramp: now → 21:00, 5000K → 2000K\nlet ramp = flow.get('closet_evening_ramp', 'file');\nif (!ramp || !ramp.active) {\n    const now = Date.now();\n    const end = new Date();\n    end.setHours(21, 0, 0, 0);\n    \n    if (end.getTime() <= now) {\n        // Past 9pm, use final values\n        msg.closet_brightness_pct = 40;\n        msg.closet_kelvin = 2000;\n        return msg;\n    }\n    \n    ramp = {\n        active: true,\n        startTs: now,\n        endTs: end.getTime(),\n        startKelvin: 5000,\n        endKelvin: 2000\n    };\n    flow.set('closet_evening_ramp', ramp, 'file');\n}\n\nconst now = Date.now();\nconst span = ramp.endTs - ramp.startTs;\nlet p = (now - ramp.startTs) / span;\np = Math.max(0, Math.min(1, p));\n\nconst kelvin = Math.round(ramp.startKelvin + p * (ramp.endKelvin - ramp.startKelvin));\n\nmsg.closet_brightness_pct = 40;\nmsg.closet_kelvin = kelvin;\n\nif (p >= 1) {\n    ramp.active = false;\n    flow.set('closet_evening_ramp', ramp, 'file');\n}\n\nreturn msg;",
