        "id": "6a8cfe802beac0f3",
        "type": "function",
        "z": "a28084d093958b9c",
        "name": "RAMP TICK → MQTT",
        "func": "// RAMP TICK → MQTT (3 outputs)\n// 1: brightness MQTT, 2: kelvin MQTT, 3: Day mode switch (optional)\n\nconst ramp = flow.get('ramp', 'file');\nif (!ramp || !ramp.active) {\n  node.status({ fill: 'grey', shape: 'ring', text: 'idle' });\n  return null;\n}\n\nconst now = Date.now();\nconst span = ramp.endTs - ramp.startTs;\nif (!isFinite(span) || span <= 0) {\n  ramp.active = false;\n  flow.set('ramp', ramp, 'file');\n  node.status({ fill: 'red', shape: 'ring', text: 'invalid window' });\n  return null;\n}\n\nlet p = (now - ramp.startTs) / span;\np = Math.max(0, Math.min(1, p));\n\nconst bri = Math.round(ramp.startBrightness + p * (ramp.endBrightness - ramp.startBrightness));\nconst kel = Math.round(ramp.startKelvin    + p * (ramp.endKelvin    - ramp.startKelvin));\n\nconst two = n => String(n).padStart(2,'0');\nconst fmt = ts => { const d = new Date(ts); return `${two(d.getHours())}:${two(d.getMinutes())}`; };\n\nfunction finalizeAndMaybeDay() {\n  ramp.active = false;\n  flow.set('ramp', ramp, 'file');\n  if (ramp.mode === 'DayOff') {\n    node.warn('DayOff ramp completed - switching to Day mode');\n    node.status({ fill: 'blue', shape: 'ring', text: 'DayOff → Day' });\n    return {\n      payload: { option: 'Day' },\n      topic: 'home/mode/day',\n      completedMode: 'DayOff',\n      nextMode: 'Day',\n      timestamp: Date.now()\n    };\n  }\n  node.status({ fill: 'blue', shape: 'ring', text: 'Ramp completed' });\n  return null;\n}\n\n// If no new integer step, only act when fully complete\nif (ramp.lastBri === bri && ramp.lastKel === kel) {\n  if (p >= 1) {\n    const dayMsg = finalizeAndMaybeDay();\n    return [null, null, dayMsg];\n  }\n  return null;\n}\n\n// Save step & update status\nramp.lastBri = bri;\nramp.lastKel = kel;\nflow.set('ramp', ramp, 'file');\n\nnode.status({\n  fill: p < 1 ? 'green' : 'blue',\n  shape: p < 1 ? 'dot' : 'ring',\n  text: `${ramp.mode} ${bri}% @ ${kel}K  (${fmt(ramp.startTs)}→${fmt(ramp.endTs)}) ${Math.round(p*100)}%`\n});\n\n// MQTT messages (retain so late-joining lights pick current step)\nconst out1 = { topic: 'home/controller/ramp/brightness', payload: bri, retain: true, qos: 1 };\nconst out2 = { topic: 'home/controller/ramp/kelvin',     payload: kel, retain: true, qos: 1 };\n\n// If we just hit the final step, publish it *and* finish now\nif (p >= 1) {\n  const dayMsg = finalizeAndMaybeDay();\n  return [out1, out2, dayMsg];\n}\n\nif (p >= 0.95) node.warn(`Ramp almost complete: ${Math.round(p*100)}%`);\nreturn [out1, out2, null];",
