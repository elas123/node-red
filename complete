    {
        "id": "590d1ef54bb5fc63",
        "type": "function",
        "z": "a28084d093958b9c",
        "name": "RAMP TICK → MQTT",
        "func": "// Engine: reads flow.ramp and publishes step values every tick.\nconst ramp = flow.get('ramp');\nif (!ramp || !ramp.active) {\n  node.status({fill:'grey',shape:'ring',text:'idle'});\n  return null;\n}\nconst now = Date.now();\nconst span = ramp.endTs - ramp.startTs;\nif (span <= 0) {\n  ramp.active = false;\n  flow.set('ramp', ramp);\n  node.status({fill:'red',shape:'ring',text:'invalid window'});\n  return null;\n}\nlet p = (now - ramp.startTs) / span;\np = Math.max(0, Math.min(1, p));\nconst bri = Math.round(ramp.startBrightness + p * (ramp.endBrightness - ramp.startBrightness));\nconst kel = Math.round(ramp.startKelvin + p * (ramp.endKelvin - ramp.startKelvin));\n// Avoid spamming identical values\nif (ramp.lastBri === bri && ramp.lastKel === kel) {\n  if (p >= 1) { ramp.active = false; flow.set('ramp', ramp); }\n  return null;\n}\n// Save & status\nramp.lastBri = bri;\nramp.lastKel = kel;\nflow.set('ramp', ramp);\nconst two = n => String(n).padStart(2,'0');\nconst fmt = ts => { const d=new Date(ts); return `${two(d.getHours())}:${two(d.getMinutes())}`; };\nnode.status({\n  fill: p<1 ? 'green' : 'blue',\n  shape: p<1 ? 'dot' : 'ring',\n  text: `${ramp.mode} ${bri}% @ ${kel}K  (${fmt(ramp.startTs)}→${fmt(ramp.endTs)})`\n});\n// Publish retained values so any light coming on reads current ramp\nconst out1 = { topic: 'home/controller/ramp/brightness', payload: bri, retain: true };\nconst out2 = { topic: 'home/controller/ramp/kelvin',     payload: kel, retain: true };\n// Stop when finished\nif (p >= 1) { ramp.active = false; flow.set('ramp', ramp); }\nreturn [out1, out2];",
