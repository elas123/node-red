        "func": "if (msg.statusCode && msg.statusCode !== 200) {\n    node.error('Pirate Weather status ' + msg.statusCode);\n    return null;\n}\nconst payload = msg.payload || {};\nconst current = payload.currently || {};\nconst hourly = payload.hourly && Array.isArray(payload.hourly.data) ? payload.hourly.data : [];\nconst hours = [];\nconst limit = Math.min(hourly.length, 12);\nconst stormBlocks = [];\nlet block = null;\nfor (let i = 0; i < limit; i += 1) {\n    const entry = hourly[i];\n    if (!entry || typeof entry.time !== 'number') continue;\n    const ts = entry.time * 1000;\n    const probability = typeof entry.precipProbability === 'number' ? entry.precipProbability : null;\n    const intensity = typeof entry.precipIntensity === 'number' ? entry.precipIntensity : null;\n    const cloud = typeof entry.cloudCover === 'number' ? Math.round(entry.cloudCover * 100) : null;\n    const condition = entry.icon || entry.summary || '';\n    hours.push({\n        ts,\n        precipProbability: probability,\n        precipIntensity: intensity,\n        cloudCover: cloud,\n        condition\n    });\n    const severe = condition.toLowerCase().includes('storm') || condition.toLowerCase().includes('thunder');\n    if ((probability != null && probability >= 0.6) || (intensity != null && intensity >= 0.3) || severe) {\n        if (!block) {\n            block = { start: ts, end: ts + 3600000, probability, intensity, condition };\n        } else if (ts <= block.end + 15 * 60 * 1000) {\n            block.end = ts + 3600000;\n            block.probability = Math.max(block.probability || 0, probability || 0);\n            block.intensity = Math.max(block.intensity || 0, intensity || 0);\n            block.condition = block.condition || condition;\n        } else {\n            stormBlocks.push(block);\n            block = { start: ts, end: ts + 3600000, probability, intensity, condition };\n        }\n    }\n}\nif (block) stormBlocks.push(block);\nconst observedAt = typeof c