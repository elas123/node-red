        "id": "497b996305b1ad75",
        "type": "function",
        "z": "a0983cb137a49b08",
        "name": "Cache Today's Sunrise/Sunset",
        "func": "if (!msg.payload || msg.statusCode !== 200) {\n    node.error(`Fetch failed: ${msg.statusCode}`);\n    node.status({fill:'red', shape:'ring', text:`Fetch failed: ${msg.statusCode}`});\n    return null;\n}\n\nconst data = msg.payload;\nif (!data.daily || !data.daily.data || !data.daily.data[0]) {\n    node.error('No daily data in response');\n    node.status({fill:'red', shape:'ring', text:'No daily data'});\n    return null;\n}\n\nconst today = data.daily.data[0];\nconst tomorrow = data.daily.data[1] || null;\n\nconst todaySunrise = today.sunriseTime * 1000;\nconst todaySunset = today.sunsetTime * 1000;\nconst tomorrowSunrise = tomorrow ? tomorrow.sunriseTime * 1000 : null;\n\nconst today730 = new Date();\ntoday730.setHours(7, 30, 0, 0);\nconst today540 = new Date();\ntoday540.setHours(5, 40, 0, 0);\n\nconst dayOffEnd = Math.max(today730.getTime(), todaySunrise + 30*60*1000);\nconst workEnd = today540.getTime();\n\nconst sunsetMinus15 = todaySunset - 15*60*1000;\nconst sunsetPlus60 = todaySunset + 60*60*1000;\n\nconst today2200 = new Date();\ntoday2200.setHours(22, 0, 0, 0);\n\nconst eveningStart = sunsetMinus15;\nconst nightStart = Math.min(sunsetPlus60, today2200.getTime());\n\nconst cache = {\n    date: new Date().toDateString(),\n    fetchTime: Date.now(),\n    sunrise: todaySunrise,\n    sunset: todaySunset,\n    tomorrowSunrise: tomorrowSunrise,\n    dayOffEndpoint: dayOffEnd,\n    workEndpoint: workEnd,\n    eveningMode: eveningStart,\n    nightMode: nightStart,\n    readable: {\n        sunriseLocal: new Date(todaySunrise).toLocaleTimeString(),\n        sunsetLocal: new Date(todaySunset).toLocaleTimeString(),\n        dayOffEndLocal: new Date(dayOffEnd).toLocaleTimeString(),\n        workEndLocal: '5:40:00 AM',\n        eveningLocal: new Date(eveningStart).toLocaleTimeString(),\n        nightLocal: new Date(nightStart).toLocaleTimeString()\n    }\n};\n\nflow.set('sunData', cache, 'file');\n\nnode.status({\n    fill:'green', \n    shape:'dot', \n    text:`☀️${cache.readable.sunriseLocal} → 🌙${cache.readable.sunsetLocal}`\n});\n\nnode.warn('╔═══════════════════════════════════════╗');\nnode.warn('║   🌅 SUN DATA CACHED SUCCESSFULLY    ║');\nnode.warn('╚═══════════════════════════════════════╝');\nnode.warn(`📅 Date: ${cache.date}`);\nnode.warn(`⏰ Fetched: ${new Date(cache.fetchTime).toLocaleTimeString()}`);\nnode.warn(`💾 PERSISTED TO FILE`);\nnode.warn('');\nnode.warn('🌄 MORNING TRANSITIONS:');\nnode.warn(`   Sunrise: ${cache.readable.sunriseLocal}`);\nnode.warn(`   Work ends: ${cache.readable.workEndLocal} (fixed)`);\nnode.warn(`   DayOff ends: ${cache.readable.dayOffEndLocal}`);\nnode.warn('');\nnode.warn('🌆 EVENING/NIGHT TRANSITIONS:');\nnode.warn(`   Sunset: ${cache.readable.sunsetLocal}`);\nnode.warn(`   Evening starts: ${cache.readable.eveningLocal}`);\nnode.warn(`   Night starts: ${cache.readable.nightLocal}`);\nnode.warn('');\nif (tomorrowSunrise) {\n    node.warn(`🌅 Tomorrow: ${new Date(tomorrowSunrise).toLocaleTimeString()}`);\n}\n\nmsg.payload = cache;\nreturn msg;",
