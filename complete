        "name": "EVENING RAMP → MQTT",
        "func": "const ha = global.get('homeassistant.homeAssistant');\nconst currentMode = ha?.states?.['input_select.home_state']?.state;\nif (currentMode !== 'Evening') {\n    node.status({ fill: 'grey', shape: 'ring', text: 'Not Evening' });\n    return null;\n}\n\nlet ramp = flow.get('eveningRamp', 'file');\nlet firstRun = false;\n\nif (!ramp || !ramp.active) {\n    const now = Date.now();\n    const end = new Date();\n    end.setHours(21, 0, 0, 0);\n    if (end.getTime() <= now) return null;\n\n    ramp = {\n        active: true,\n        startTs: now,\n        endTs: end.getTime(),\n        startKelvin: 5000,\n        endKelvin: 2700,\n        lastKel: undefined\n    };\n    flow.set('eveningRamp', ramp, 'file');\n    firstRun = true;\n}\n\nconst now = Date.now();\nconst span = ramp.endTs - ramp.startTs;\nif (span <= 0) { ramp.active = false; flow.set('eveningRamp', ramp, 'file'); return null; }\n\nlet p = (now - ramp.startTs) / span;\np = Math.max(0, Math.min(1, p));\n\nconst kel = Math.round(ramp.startKelvin + p * (ramp.endKelvin - ramp.startKelvin));\n\nif (!firstRun && ramp.lastKel === kel) {\n    if (p >= 1) { ramp.active = false; flow.set('eveningRamp', ramp, 'file'); }\n    return null;\n}\n\nramp.lastKel = kel;\nflow.set('eveningRamp', ramp, 'file');\n\nconst two = n => String(n).padStart(2, '0');\nconst fmt = ts => { const d = new Date(ts); return `${two(d.getHours())}:${two(d.getMinutes())}`; };\nnode.status({ fill: p < 1 ? 'green' : 'blue', shape: p < 1 ? 'dot' : 'ring', text: `Evening 60% @ ${kel}K (${fmt(ramp.startTs)}→${fmt(ramp.endTs)})` });\n\n// First run: publish both. After that: only kelvin\nconst out1 = firstRun ? { topic: 'home/controller/ramp/brightness', payload: 60, retain: true } : null;\nconst out2 = { topic: 'home/controller/ramp/kelvin', payload: kel, retain: true };\n\nif (p >= 1) { ramp.active = false; flow.set('eveningRamp', ramp, 'file'); }\nreturn [out1, out2];",
