    {
        "id": "fn_2300_decide",
        "type": "function",
        "z": "tab_minimal_night",
        "name": "23:00 decide (Evening / states → timer or Night)",
        "func": "// Reads HA global states (enableGlobalContextStore must be true)\nconst hass = global.get('homeassistant');\nif (!hass || !hass.homeAssistant || !hass.homeAssistant.states) return [null, null];\nconst S = hass.homeAssistant.states;\nconst mode = S['input_select.home_state']?.state;\nif (mode !== 'Evening') return [null, null];\nconst onRe = /^(playing|paused|on)$/;\nconst bed = S['media_player.bedroom']?.state || '';\nconst liv = S['media_player.apple_tv_4k_livingroom']?.state || '';\nconst bedOn = onRe.test(bed);\nconst livOn = onRe.test(liv);\nif (bedOn) {\n  // Night now\n  return [null, { payload: 'Night', origin: '2300_bedroom_on' }];\n}\nif (livOn) {\n  // Wait for living to go off; cancel any old timer\n  flow.set('night_waiting', true);\n  return [{ reset: 'reset', topic: 'night_timer', origin: '2300_living_on' }, null];\n}\n// both OFF → start timer now\nflow.set('night_waiting', false);\nreturn [{ topic: 'night_timer', origin: '2300_both_off' }, null];",
        "outputs": 2,
        "noerr": 0,
        "x": 470,
        "y": 120,
        "wires": [
            [
                "trg_30m"
            ],
            [
                "svc_set_night"
            ]
        ]
    },
