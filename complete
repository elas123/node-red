        "func": "const data = msg.payload;\nif (!data || !data.source) return null;\nconst ctx = flow.get('weatherContext') || { providers: {}, summary: {}, _lastStormKey: null };\ndata.receivedAt = Date.now();\nctx.providers[data.source] = data;\nconst providers = Object.values(ctx.providers);\nconst cloudValues = [];\nlet maxProb = null;\nlet maxIntensity = null;\nconst stormCandidates = [];\nfor (const provider of providers) {\n    if (provider && typeof provider.cloudCover === 'number') cloudValues.push(provider.cloudCover);\n    if (provider && typeof provider.precipProbability === 'number') maxProb = Math.max(maxProb ?? provider.precipProbability, provider.precipProbability);\n    if (provider && typeof provider.precipIntensity === 'number') maxIntensity = Math.max(maxIntensity ?? provider.precipIntensity, provider.precipIntensity);\n    if (provider && Array.isArray(provider.hourly)) {\n        for (const entry of provider.hourly) {\n            if (!entry || typeof entry.ts !== 'number') continue;\n            const prob = typeof entry.precipProbability === 'number' ? entry.precipProbability : null;\n            const intensity = typeof entry.precipIntensity === 'number' ? entry.precipIntensity : null;\n            const condition = (entry.condition || '').toLowerCase();\n            const severe = condition.includes('storm') || condition.includes('thunder');\n            if ((prob != null && prob >= 0.6) || (intensity != null && intensity >= 0.3) || severe) {\n                stormCandidates.push({ source: provider.source, start: entry.ts, end: entry.ts + 3600000, probability: prob, intensity, condition: entry.condition || null });\n            }\n        }\n    }\n    if (provider && provider.stormWindow && typeof provider.stormWindow.start === 'number') {\n        stormCandidates.push({ source: provider.source, start: provider.stormWindow.start, end: provider.stormWindow.end, probability: provider.stormWindow.probability ?? null, intensity: provider.stormWindow.intensity ?? null, condition: provider.stormWindow.condition || null });\n    }\n    if (provider && Array.isArray(provider.alerts)) {\n        for (const alert of provider.alerts) {\n            if (!alert) continue;\n            const start = alert.effective ? Date.parse(alert.effective) : Date.now();\n            const end = alert.expires ? Date.parse(alert.expires) : start + 2 * 60 * 60 * 1000;\n            stormCandidates.push({ source: provider.source + '_alert', start: Number.isFinite(start) ? start : Date.now(), end: Number.isFinite(end) ? end : Date.now() + 7200000, probability: 1, intensity: null, condition: alert.event || 'alert' });\n        }\n    }\n}\nstormCandidates.sort((a, b) => a.start - b.start);\nconst now = Date.now();\nconst upcoming = stormCandidates.filter(item => item.end > now);\nlet stormWatch = null;\nif (upcoming.length) {\n    stormWatch = { ...upcoming[0] };\n    for (let i = 1; i < upcoming.length; i += 1) {\n        const item = upcoming[i];\n        if (item.start <= stormWatch.end + 15 * 60 * 1000) {\n            stormWatch.end = Math.max(stormWatch.end, item.end);\n            if (typeof item.probability === 'number') stormWatch.probability = Math.max(stormWatch.probability ?? 0, item.probability);\n            if (typeof item.intensity === 'number') stormWatch.intensity = Math.max(stormWatch.intensity ?? 0, item.intensity);\n            if (!stormWatch.condition && item.condition) stormWatch.condition = item.condition;\n        } else break;\n    }\n}\nconst cloudAvg = cloudValues.length ? Math.round(cloudValues.reduce((sum, val) => sum + val, 0) / cloudValues.length) : null;\nlet conditionTag = 'normal';\nif (stormWatch) {\n    const prob = stormWatch.probability ?? 0;\n    const intensity = stormWatch.intensity ?? 0;\n    conditionTag = (prob >= 0.85 || intensity >= 0.6) ? 'storm_heavy' : 'storm_imminent';\n} else if (cloudAvg != null) {\n    if (cloudAvg >= 75) conditionTag = 'overcast';\n    else if (cloudAvg <= 25) conditionTag = 'bright';\n}\nlet sunElevation = null;\nconst hass = global.get('homeassistant');\nif (hass && hass.homeAssistant && hass.homeAssistant.states && hass.homeAssistant.states['sun.sun']) {\n    const attrs = hass.homeAssistant.states['sun.sun'].attributes || {};\n    if (typeof attrs.elevation === 'number') sunElevation = attrs.elevation;\n}\nconst providerTimestamps = {};\nfor (const [key, value] of Object.entries(ctx.providers)) {\n    providerTimestamps[key] = value ? value.observedAt || value.receivedAt || null : null;\n}\nconst summary = {\n    updatedAt: now,\n    cloudCoverPct: cloudAvg,\n    precipProbabilityPct: maxProb != null ? Math.round(maxProb * 100) : null,\n    precipIntensity: maxIntensity,\n    conditionTag,\n    stormWatch,\n    sunElevation,\n    providersUpdated: providerTimestamps\n};\nctx.summary = summary;\nctx.updatedAt = now;\nconst stormKey = stormWatch ? [stormWatch.start, stormWatch.end, conditionTag].join('|') : 'none';\nconst previousKey = ctx._lastStormKey || 'none';\nctx._lastStormKey = stormKey;\nflow.set('weatherContext', ctx);\nglobal.set('weatherContext', ctx);\nconst out1 = { payload: ctx, topic: 'weatherContext' };\nlet out2 = null;\nif (stormKey !== previousKey) out2 = { payload: stormWatch, tag: conditionTag };\nconst fill = conditionTag === 'storm_heavy' ? 'red' : (conditionTag === 'storm_imminent' ? 'yellow' : 'green');\nnode.status({ fill, shape: stormWatch ? 'dot' : 'ring', text: conditionTag + (cloudAvg != null ? ' ' + cloudAvg + '%' : '') });\nreturn [out1, out2];",
