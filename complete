        "type": "function",
        "z": "a28084d093958b9c",
        "name": "Parse & Display Sunrise/Sunset",
        "func": "// Check if we got data\nif (!msg.payload || msg.statusCode !== 200) {\n    node.error(\"API call failed: \" + msg.statusCode);\n    node.status({fill:'red',shape:'ring',text:'API failed'});\n    return null;\n}\n\nconst data = msg.payload;\nnode.warn(\"=== PIRATE WEATHER DATA ===\");\nnode.warn(`Full response: ${JSON.stringify(data).substring(0,500)}...`);\n\n// Get today's data\nif (data.daily && data.daily.data && data.daily.data[0]) {\n    const today = data.daily.data[0];\n    \n    // Convert Unix timestamps to milliseconds\n    const sunriseMs = today.sunriseTime * 1000;\n    const sunsetMs = today.sunsetTime * 1000;\n    \n    // Convert to local time\n    const sunrise = new Date(sunriseMs);\n    const sunset = new Date(sunsetMs);\n    \n    node.warn(`TODAY'S SUNRISE: ${sunrise.toLocaleTimeString()}`);\n    node.warn(`TODAY'S SUNSET: ${sunset.toLocaleTimeString()}`);\n    node.warn(`Sunrise + 30min: ${new Date(sunriseMs + 30*60*1000).toLocaleTimeString()}`);\n    \n    // Calculate 7:30 floor vs sunrise+30\n    const today730 = new Date();\n    today730.setHours(7, 30, 0, 0);\n    const floor730 = today730.getTime();\n    const sunrisePlus30 = sunriseMs + 30*60*1000;\n    const endTime = Math.max(floor730, sunrisePlus30);\n    \n    node.warn(`7:30 AM floor: ${today730.toLocaleTimeString()}`);\n    node.warn(`DayOff should end at: ${new Date(endTime).toLocaleTimeString()}`);\n    \n    node.status({\n        fill:'green',\n        shape:'dot',\n        text:`☀️ ${sunrise.toLocaleTimeString()} 🌅 ${sunset.toLocaleTimeString()}`\n    });\n    \n    // Tomorrow's data\n    if (data.daily.data[1]) {\n        const tomorrow = data.daily.data[1];\n        const tmrSunrise = new Date(tomorrow.sunriseTime * 1000);\n        node.warn(`TOMORROW'S SUNRISE: ${tmrSunrise.toLocaleTimeString()}`);\n    }\n} else {\n    node.error(\"No daily data found\");\n    node.status({fill:'red',shape:'ring',text:'No data'});\n}\n\nreturn msg;",
