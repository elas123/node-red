        "func": "// Function: \"Cache Today's Sunrise/Sunset\"\n// Validate response\nif (!msg.payload || msg.statusCode !== 200) {\n    node.error(`Prefetch failed: ${msg.statusCode}`);\n    node.send([null, { payload: 5 }]); // Retry\n    return;\n}\n\nconst data = msg.payload;\nif (!data.daily || !data.daily.data || !data.daily.data[0]) {\n    node.error('No daily data in response');\n    return;\n}\n\n// Extract today and tomorrow\nconst today = data.daily.data[0];\nconst tomorrow = data.daily.data[1] || null;\n\n// Convert to milliseconds\nconst todaySunrise = today.sunriseTime * 1000;\nconst todaySunset = today.sunsetTime * 1000;\nconst tomorrowSunrise = tomorrow ? tomorrow.sunriseTime * 1000 : null;\n\n// Morning calculations\nconst today730 = new Date();\ntoday730.setHours(7, 30, 0, 0);\nconst today540 = new Date();\ntoday540.setHours(5, 40, 0, 0);\n\n// Work ALWAYS ends at 5:40 AM (fixed time, no sunrise logic)\nconst workEnd = today540.getTime();\n\n// DayOff ends at sunrise+30 with 7:30 AM floor\nconst dayOffEnd = Math.max(today730.getTime(), todaySunrise + 30 * 60 * 1000);\n\n// Evening/Night calculations\nconst sunsetMinus30 = todaySunset - 30 * 60 * 1000;  // 30 min before sunset\nconst sunsetMinus15 = todaySunset - 15 * 60 * 1000;  // 15 min before sunset\nconst sunsetPlus30 = todaySunset + 30 * 60 * 1000;   // 30 min after sunset\nconst sunsetPlus60 = todaySunset + 60 * 60 * 1000;   // 1 hour after sunset\n\n// Fixed evening times for floors/ceilings\nconst today2030 = new Date();\ntoday2030.setHours(20, 30, 0, 0);  // 8:30 PM\nconst today2200 = new Date();\ntoday2200.setHours(22, 0, 0, 0);   // 10:00 PM\n\n// Calculate evening mode transition (earliest of: sunset-15 or 8:30 PM)\nconst eveningStart = Math.min(sunsetMinus15, today2030.getTime());\n\n// Calculate night mode transition (earliest of: sunset+60 or 10:00 PM)\nconst nightStart = Math.min(sunsetPlus60, today2200.getTime());\n\n// Cache everything\nconst cache = {\n    date: new Date().toDateString(),\n    fetchTime: Date.now(),\n\n    // Raw times\n    sunrise: todaySunrise,\n    sunset: todaySunset,\n    tomorrowSunrise: tomorrowSunrise,\n\n    // Morning endpoints\n    dayOffEndpoint: dayOffEnd,\n    workEndpoint: workEnd,  // Always 5:40 AM\n\n    // Evening/Night transitions\n    eveningMode: eveningStart,\n    nightMode: nightStart,\n    sunsetMinus30: sunsetMinus30,\n    sunsetMinus15: sunsetMinus15,\n    sunsetPlus30: sunsetPlus30,\n    sunsetPlus60: sunsetPlus60,\n\n    // Human readable\n    readable: {\n        sunriseLocal: new Date(todaySunrise).toLocaleTimeString(),\n        sunsetLocal: new Date(todaySunset).toLocaleTimeString(),\n        dayOffEndLocal: new Date(dayOffEnd).toLocaleTimeString(),\n        workEndLocal: new Date(workEnd).toLocaleTimeString(),\n        eveningStartLocal: new Date(eveningStart).toLocaleTimeString(),\n        nightStartLocal: new Date(nightStart).toLocaleTimeString()\n    }\n};\n\n// Store in both memory and file\nflow.set('sunData', cache, 'file');  // Survives restart\nflow.set('sunData', cache);          // Fast access\n\nnode.warn('=== SUN DATA CACHED ===');\nnode.warn(`Sunrise: ${cache.readable.sunriseLocal}`);\nnode.warn(`Sunset: ${cache.readable.sunsetLocal}`);\nnode.warn(`Work ends: ${cache.readable.workEndLocal} (FIXED 5:40 AM)`);\nnode.warn(`DayOff ends: ${cache.readable.dayOffEndLocal} (sunrise+30 or 7:30 AM)`);\nnode.warn(`Evening Mode: ${cache.readable.eveningStartLocal}`);\nnode.warn(`Night Mode: ${cache.readable.nightStartLocal}`);\n\nnode.status({\n    fill: 'green',\n    shape: 'dot',\n    text: `☀️${cache.readable.sunriseLocal} 🌅${cache.readable.sunsetLocal}`\n});\n\nreturn [{ payload: cache }, null];",
