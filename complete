        "name": "Smart restore based on sun cache",
        "func": "node.warn('🔍 RESTORE FUNCTION STARTED');\n\nconst cache = flow.get('sunData', 'file') || flow.get('sunData');\n\nif (!cache || !cache.date || cache.date !== new Date().toDateString()) {\n    node.warn('❌ No valid cache found - triggering fetch');\n    node.status({fill:'red', shape:'ring', text:'No cache - fetching'});\n    return [null, msg];\n}\n\nnode.warn('✅ Using cached sun data:');\nnode.warn(`   Sunrise: ${cache.readable.sunriseLocal}`);\nnode.warn(`   Sunset: ${cache.readable.sunsetLocal}`);\nnode.warn(`   Day starts: ${cache.readable.dayOffEndLocal}`);\nnode.warn(`   Evening starts: ${cache.readable.eveningLocal}`);\nnode.warn(`   Night starts: ${cache.readable.nightLocal}`);\n\nconst now = Date.now();\n\nlet restoreMode;\nconst dayOfWeek = new Date().getDay();\nconst isWorkDay = (dayOfWeek >= 1 && dayOfWeek <= 4);\n\nif (now < cache.dayOffEndpoint) {\n    restoreMode = isWorkDay ? 'Work' : 'DayOff';\n    node.warn(`🌅 Before morning ramp end → ${restoreMode}`);\n}\nelse if (now < cache.eveningMode) {\n    restoreMode = 'Day';\n    node.warn(`☀️ After morning, before evening → Day`);\n}\nelse if (now < cache.nightMode) {\n    restoreMode = 'Evening';\n    node.warn(`🌆 After evening start, before night → Evening`);\n}\nelse {\n    restoreMode = 'Night';\n    node.warn(`🌙 After night trigger time → Night`);\n}\n\nnode.warn(`✅ Away restore → ${restoreMode}`);\nnode.status({fill:'green', shape:'dot', text:`Restored to: ${restoreMode}`});\n\nmsg.payload = restoreMode;\nglobal.set('away_prev', undefined);\nglobal.set('away_prev', undefined, 'file');\nreturn [msg, null];",
