        "z": "466efa5a6e2c912f",
        "name": "Build payload if Work/DayOff",
        "func": "// Read HA mode from global (Node-RED HA plugin keeps it here)\nconst ha = global.get('homeassistant.homeAssistant');\nconst homeState = ha && ha.states && ha.states['input_select.home_state'] && ha.states['input_select.home_state'].state;\nif (homeState !== 'Work' && homeState !== 'DayOff') {\n  return null; // Only follow ramp during Work/DayOff\n}\n\nconst b = flow.get('rampBrightness');\nconst k = flow.get('rampKelvin');\nif (b == null || k == null) return null; // need both\n\nconst brightness_pct = Number.parseInt(b, 10);\nconst color_temp_kelvin = Number.parseInt(k, 10);\nif (Number.isNaN(brightness_pct) || Number.isNaN(color_temp_kelvin)) return null;\n\nmsg.payload = { brightness_pct, color_temp_kelvin };\nmsg.topic = 'living_room_ramp';\nnode.status({fill:'green', shape:'dot', text: `${homeState}: ${brightness_pct}% @ ${color_temp_kelvin}K`});\nreturn msg;",
