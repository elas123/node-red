    {
        "id": "3270f64e67c2de72",
        "type": "function",
        "z": "976ea15b02404004",
        "name": "Calculate Evening Ramp (40%/2000K)",
        "func": "// Per-room evening BRIGHTNESS ramp for HALLWAY.\n// Now → 21:00, 60% → 40%. No kelvin touched.\n\n// ---- tweak here if you want different numbers ----\nconst START_PCT = 60;   // brightness when ramp starts\nconst END_PCT   = 40;   // brightness by end time\nconst END_H     = 21;   // 21:00 = 9pm\nconst END_M     = 0;\n// --------------------------------------------------\n\nlet ramp = flow.get('hallway_evening_bri_ramp', 'file');\n\nif (!ramp || !ramp.active) {\n  const now = Date.now();\n  const end = new Date();\n  end.setHours(END_H, END_M, 0, 0);\n\n  // If it's already past end time, just use final brightness\n  if (end.getTime() <= now) {\n    msg.hallway_brightness_pct = END_PCT;\n    return msg;\n  }\n\n  ramp = {\n    active: true,\n    startTs: now,\n    endTs: end.getTime(),\n    startPct: START_PCT,\n    endPct: END_PCT,\n    lastPct: undefined\n  };\n  flow.set('hallway_evening_bri_ramp', ramp, 'file');\n}\n\nconst nowTs = Date.now();\nconst span = ramp.endTs - ramp.startTs;\nlet p = (nowTs - ramp.startTs) / span;\np = Math.max(0, Math.min(1, p));\n\nconst pct = Math.round(ramp.startPct + p * (ramp.endPct - ramp.startPct));\n\n// Avoid spamming identical commands\nif (ramp.lastPct === pct && p < 1) return null;\n\nramp.lastPct = pct;\nif (p >= 1) ramp.active = false;\nflow.set('hallway_evening_bri_ramp', ramp, 'file');\n\nmsg.hallway_brightness_pct = pct;\nreturn msg;",
