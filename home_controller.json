// Will normalize and route accordingly.\n\nfunction norm(s){ return (s||'').toString().toLowerCase(); }\n\nlet anyAway;\n\nif (typeof msg.any_away === 'boolean') {\n    anyAway = msg.any_away;\n} else {\n    let p1 = msg.p1 ?? (msg.payload && msg.payload.p1);\n    let p2 = msg.p2 ?? (msg.payload && msg.payload.p2);\n    p1 = norm(p1);\n    p2 = norm(p2);\n    const bothHome = (p1 === 'home' && p2 === 'home');\n    anyAway = !bothHome;\n}\n\n// Output 1 when ANY is away, Output 2 when BOTH are home\nreturn anyAway ? [msg, null] : [null, msg];","outputs":2,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1470,"y":380,"wires":[["fec536f5c2ac06bd"],["f76caebc9396a7d6"]]},{"id":"983f947e.e557a8","type":"server","name":"Home Assistant","version":5,"addon":true,"rejectUnauthorizedCerts":true,"ha_boolean":"y|yes|true|on|home|open","connectionDelay":true,"cacheJson":true,"heartbeat":false,"heartbeatInterval":"30","areaSelector":"friendlyName","deviceSelector":"friendlyName","entitySelector":"friendlyName","statusSeparator":"at: ","statusYear":"hidden","statusMonth":"short","statusDay":"numeric","statusHourCycle":"h23","statusTimeFormat":"h:m","enableGlobalContextStore":true}]